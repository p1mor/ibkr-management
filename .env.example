# Archivo de ejemplo de configuración
# Copiar este archivo a .env y personalizar con tus valores

# ===== CONEXIÓN IBKR =====
IBKR_HOST=127.0.0.1
IBKR_PORT=4002                    # Paper=4002, Live=4001 (IB Gateway por defecto)
IBKR_CLIENT_ID=1                  # ID único para esta conexión (1-32)
IBKR_TIMEOUT=30

# ===== CONFIGURACIÓN DE CONTRATO =====
IBKR_SYMBOL=ES                    # ES(SP500), NQ(NASDAQ100), YM(Dow Jones), RTY(Russell 2000), etc.
IBKR_SEC_TYPE=FUT                 # FUT=Futuros, STK=Acciones
IBKR_EXCHANGE=CME                 # CME, GLOBEX, NASDAQ, etc.
IBKR_CURRENCY=USD
IBKR_CONTRACT_MONTH=202603        # YYYYMM (actualizar mensualmente)

# ===== ALMACENAMIENTO =====
DATA_OUTPUT_DIR=./data
BUFFER_FLUSH_INTERVAL=60          # Segundos entre flush de buffer
BUFFER_MAX_SIZE=10000             # Máximo registros antes de forzar flush 
MARKET_DEPTH_ROWS=10              # Niveles de order book (1-10)

# ===== LOGGING =====
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
LOG_FILE=ib_gateway_audit.log

# ===== RECONEXIÓN =====
MAX_RECONNECTION_ATTEMPTS=0       # 0 = intentos infinitos
RECONNECTION_DELAY=10             # Segundos entre intentos

# ===== VALIDACIÓN =====
MAX_SPREAD_THRESHOLD=0.1          # Máximo spread permitido (10%)
MIN_DEPTH_LEVELS=1                # Mínimo niveles por lado del book
